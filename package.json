{
  "name": "improvemyagent",
  "version": "0.2.1",
  "description": "Learns from every time you corrected your coding agent (Claude Code, Codex, OpenCode, Gemini CLI, Cursor) and turns it into rules in AGENTS.md / CLAUDE.md.",
  "type": "module",
  "bin": {
    "improvemyagent": "dist/cli.js"
  },
  "files": [
    "dist",
    "guard",
    "docs/screenshot.png",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "deploy:site": "npx -y wrangler@4 deploy",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.18"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@clack/prompts": "^1.8.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "claude-code",
    "codex",
    "agents-md",
    "claude-md",
    "coding-agent",
    "ai-agents",
    "opencode",
    "gemini-cli",
    "cursor",
    "developer-tools"
  ],
  "author": "Agnost AI (https://agnost.ai)",
  "homepage": "https://improvemyagent.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgnostAI/improvemyagent.git"
  },
  "bugs": {
    "url": "https://github.com/AgnostAI/improvemyagent/issues"
  }
}
